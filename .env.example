# Google Drive / Sheets / Docs / Slides integration values will be decided after design.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEETS_SOURCE_ID=

# 固定のPDF生成先。スマホからも同じアプリURLで利用する。
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbypf--ECDZXeaXM32FvkkO_f1092xI-_L75k2LnceqsImgUgQk9ZgJFn6wLd_A1Imgz/exec

# 共有保存を有効にする場合だけ true にする。Google Cloud OAuthのWeb client IDが必要。
VITE_SHARED_STORAGE_ENABLED=false
VITE_GOOGLE_CLIENT_ID=

# App name
APP_DISPLAY_NAME=オシゴトアプリ
